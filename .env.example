# Copy this file to .env and fill in your values.
# The .env file is read by docker-compose and injected into the container.
# It is gitignored — never commit real credentials.

# ── Anthropic (required for the daily pipeline) ───────────────────────────────
# Used by the trader panel/debate/judge stages and the executive summary.
# There is no keyring (secret-tool) inside a container, so this must be set here.
ANTHROPIC_API_KEY=

# ── Trading212 (optional — stock portfolio stage is skipped if unset) ─────────
TRADING_212_API_KEY=
TRADING_212_API_SECRET=

# ── Crypto.com Exchange (optional — crypto portfolio stage skipped if unset) ──
CRYPTO_API_KEY=
CRYPTO_API_SECRET=

# ── Email delivery (required to receive the daily report) ─────────────────────
# Gmail: SMTP_PASSWORD must be a Google *app password*, not your account
# password. Generate one at https://myaccount.google.com/apppasswords — this
# requires 2-Step Verification to be enabled on the account first.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
REPORT_TO=you@gmail.com
# Optional — defaults to SMTP_USER
REPORT_FROM=

# ── Container ─────────────────────────────────────────────────────────────────
# The pipeline keys its run directories off the local date; set this to your
# own timezone so "today" in the report matches your day.
TZ=Europe/London
